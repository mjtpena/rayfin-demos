[37.102, "o", "."]
[37.142, "o", "y"]
[37.174, "o", "m"]
[37.226, "o", "l"]
[37.576, "o", "\r\n"]
[37.611, "o", "name: Deploy to Fabric\r\n"]
[37.611, "o", "\r\n"]
[37.611, "o", "on:\r\n"]
[37.611, "o", "  push:\r\n"]
[37.611, "o", "    branches: [main]\r\n"]
[37.611, "o", "  workflow_dispatch:\r\n"]
[37.611, "o", "    inputs:\r\n"]
[37.611, "o", "      force:\r\n"]
[37.611, "o", "        description: 'Allow destructive schema changes that may result in data loss'\r\n"]
[37.611, "o", "        required: false\r\n"]
[37.611, "o", "        default: false\r\n"]
[37.611, "o", "        type: boolean\r\n"]
[37.611, "o", "\r\n"]
[37.611, "o", "concurrency:\r\n"]
[37.611, "o", "  group: ${{ github.workflow }}-${{ github.ref }}\r\n"]
[37.611, "o", "  cancel-in-progress: true\r\n"]
[37.611, "o", "\r\n"]
[37.611, "o", "permissions:\r\n"]
[37.611, "o", "  contents: read\r\n"]
[37.611, "o", "\r\n"]
[37.611, "o", "jobs:\r\n"]
[37.611, "o", "  deploy:\r\n"]
[37.611, "o", "    name: Deploy to Fabric\r\n"]
[37.611, "o", "    runs-on: ubuntu-latest\r\n"]
[37.611, "o", "    env:\r\n"]
[37.611, "o", "      CLIENT_ID: ${{ secrets.CLIENT_ID }}\r\n"]
[37.611, "o", "      TENANT_ID: ${{ secrets.TENANT_ID }}\r\n"]
[37.611, "o", "      CLIENT_SECRET: ${{ secrets.CLIENT_SECRET }}\r\n"]
[37.611, "o", "      FABRIC_WORKSPACE_NAME: ${{ secrets.FABRIC_WORKSPACE_NAME }}\r\n"]
[37.611, "o", "    steps:\r\n"]
[37.611, "o", "      - name: Checkout repository\r\n"]
[37.611, "o", "        uses: actions/checkout@v4\r\n"]
[37.611, "o", "\r\n"]
[37.611, "o", "      - name: Setup Node.js\r\n"]
[37.611, "o", "        uses: actions/setup-node@v4\r\n"]
[37.611, "o", "        with:\r\n"]
[37.611, "o", "          node-version: '20'\r\n"]
[37.611, "o", "          cache: npm\r\n"]
[37.611, "o", "\r\n"]
[37.611, "o", "      # rayfin up compiles rayfin/data/*.ts and runs the static build, both of\r\n"]
[37.611, "o", "      # which need the project's node_modules.\r\n"]
[37.611, "o", "      - name: Install project dependencies\r\n"]
[37.611, "o", "        run: npm ci\r\n"]
[37.611, "o", "\r\n"]
[37.611, "o", "      - name: Install Rayfin CLI\r\n"]
[37.611, "o", "        run: npm install -g @microsoft/rayfin-cli\r\n"]
[37.611, "o", "\r\n"]
[37.611, "o", "      # The CLI loads keytar on login even with --encryption-fallback-enabled,\r\n"]
[37.611, "o", "      # and keytar needs libsecret, which the ubuntu-24.04 runner image lacks.\r\n"]
[37.611, "o", "      - name: Install libsecret\r\n"]
[37.611, "o", "        run: sudo apt-get update -q && sudo apt-get install -y -q libsecret-1-0\r\n"]
[37.611, "o", "\r\n"]
[37.611, "o", "      # Hosted runners have no OS keychain, so let the CLI keep its token cache\r\n"]
[37.611, "o", "      # in plain files. The runner is discarded after the job.\r\n"]
[37.611, "o", "      - name: Login to Rayfin with service principal\r\n"]
[37.611, "o", "        run: |\r\n"]
[37.611, "o", "          rayfin login \\\r\n"]
[37.611, "o", "            --service-principal \\\r\n"]
[37.611, "o", "            --encryption-fallback-enabled \\\r\n"]
[37.611, "o", "            -t \"$TENANT_ID\" -u \"$CLIENT_ID\" -p \"$CLIENT_SECRET\"\r\n"]
[37.611, "o", "\r\n"]
[37.611, "o", "      - name: Deploy to Fabric\r\n"]
[37.611, "o", "        run: |\r\n"]
[37.611, "o", "          EXTRA_ARGS=\"\"\r\n"]
[37.611, "o", "          if [[ \"${{ inputs.force }}\" == \"true\" ]]; then\r\n"]
[37.611, "o", "            EXTRA_ARGS=\"$EXTRA_ARGS --force\"\r\n"]
[37.611, "o", "          fi\r\n"]
[37.611, "o", "          rayfin up \\\r\n"]
[37.611, "o", "            --workspace \"$FABRIC_WORKSPACE_NAME\" \\\r\n"]
[37.611, "o", "            --yes \\\r\n"]
[37.611, "o", "            $EXTRA_ARGS\r\n"]
[41.811, "o", "\u001b[2J\u001b[H"]
