[31.863, "o", "\u001b[1;32m❯\u001b[0m "]
[32.013, "o", "\u001b[38;5;244m# The target workspace in Fabric, before the first run\u001b[0m\r\n"]
[33.913, "o", "\u001b[2J\u001b[H"]
[34.413, "o", "\u001b[1;32m❯\u001b[0m "]
[34.563, "o", "\u001b[38;5;244m# Step 3: The workflow\u001b[0m\r\n"]
[35.563, "o", "\u001b[1;32m❯\u001b[0m "]
[35.591, "o", "c"]
[35.63, "o", "a"]
[35.668, "o", "t"]
[35.704, "o", " "]
[35.751, "o", "."]
[35.778, "o", "g"]
