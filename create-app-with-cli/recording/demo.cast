[30.49, "o", "} from '@microsoft/rayfin-core';\r\n"]
[30.49, "o", "\r\n"]
[30.49, "o", "@entity()\r\n"]
[30.49, "o", "@role('authenticated', '*', {\r\n"]
[30.49, "o", "  policy: (claims, item) => claims.sub.eq(item.user_id),\r\n"]
[30.49, "o", "})\r\n"]
[30.49, "o", "export class Todo {\r\n"]
[30.49, "o", "  @uuid() id!: string;\r\n"]
[30.49, "o", "  @text({ min: 1, max: 100 }) title!: string;\r\n"]
[30.49, "o", "  @boolean() isCompleted!: boolean;\r\n"]
[30.49, "o", "  @date() createdAt!: Date;\r\n"]
[30.49, "o", "  @text() user_id!: string;\r\n"]
[30.49, "o", "}\r\n"]
